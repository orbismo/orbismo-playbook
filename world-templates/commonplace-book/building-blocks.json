{
    "entity_types": [
        {
            "type_name": "source",
            "label": "Source",
            "description": "Where something came from: a book, article, podcast, site, talk or conversation. Created only when the owner names one.",
            "icon": null,
            "property_schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Link to the source, when it lives online."
                    },
                    "author": {
                        "type": "string",
                        "description": "Who made it: writer, host, speaker."
                    },
                    "medium": {
                        "type": "string",
                        "description": "What form it takes: book, article, podcast, site, talk, conversation, etc."
                    }
                }
            },
            "display_order": 0,
            "is_active": true
        },
        {
            "type_name": "person",
            "label": "Person",
            "description": "Someone the owner mentions. Kept light — not a contact database, and only what the owner says.",
            "icon": null,
            "property_schema": {
                "type": "object",
                "properties": {
                    "context": {
                        "type": "string",
                        "description": "Who they are to the owner."
                    },
                    "where_met": {
                        "type": "string",
                        "description": "Where the owner met or knows them from."
                    }
                }
            },
            "display_order": 0,
            "is_active": true
        },
        {
            "type_name": "note",
            "label": "Note",
            "description": "The core unit of the commonplace book: one idea per note, named with a short handle in the owner's words. Longer text goes in a lore chunk.",
            "icon": "description",
            "property_schema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "For link notes: the address itself."
                    },
                    "kind": {
                        "enum": [
                            "idea",
                            "quote",
                            "observation",
                            "question",
                            "link"
                        ],
                        "type": "string",
                        "enumerable": true,
                        "description": "What sort of capture this is."
                    },
                    "status": {
                        "enum": [
                            "raw",
                            "developing",
                            "used",
                            "archived"
                        ],
                        "type": "string",
                        "enumerable": true,
                        "description": "Where this note is in its life."
                    }
                }
            },
            "display_order": 0,
            "is_active": true
        },
        {
            "type_name": "rule",
            "label": "Rule",
            "description": "Standing guidance for the AI working in this world. Substance lives in lore chunks; the rule index in the world instructions says when to read each one. Only rules with status active apply.",
            "icon": null,
            "property_schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "enum": [
                            "active",
                            "draft",
                            "archived"
                        ],
                        "type": "string",
                        "enumerable": true,
                        "description": "Whether this rule currently applies."
                    }
                }
            },
            "display_order": 0,
            "is_active": true
        }
    ],
